draw_set_halign(fa_right);
draw_set_valign(fa_bottom);
draw_text(window_get_width(), window_get_height(), $"Hold [Z] to show grid panels.\nPress [Insert] to toggle Edit Mode.\nPress Export to generate a Create.gml for the current tagged elements.\nFile is being saved to path {AirUISavePath}");
draw_set_halign(fa_left);
draw_set_valign(fa_top);